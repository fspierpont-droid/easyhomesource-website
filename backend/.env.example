# Permanent Easy HomeSource backend configuration.
# Never commit real secret values.
APP_ENV=development
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<database>
DB_NAME=easyhomesource_production
JWT_SECRET=<generate-a-random-secret-at-least-32-characters>
EHS_INTERNAL_API_KEY=<same-random-secret-used-by-the-vercel-portal-server>
CORS_ORIGINS=http://localhost:3000
JWT_EXP_HOURS=12
MIN_PASSWORD_LENGTH=10
ENABLE_API_DOCS=false

# Delivery routing. Google Distance Matrix is optional; when omitted, the quote
# builder requires confirmed manual route miles instead of inventing distance.
GOOGLE_MAPS_API_KEY=<server-side-google-maps-api-key>
EHS_DEALERSHIP_ADDRESS=9011 McIntyre Rd, Brooksville, FL 34601
